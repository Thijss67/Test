# Het formulier stuurt naar /api/contact zonder extensie; hier vertalen we
# dat naar het php-bestand. Zo blijft het adres netjes en verandert er niets
# aan de pagina zelf.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /api/
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^contact/?$ contact.php [L]
	RewriteRule ^concept/?$ concept.php [L]
</IfModule>

# Geen mappenlijst; hier hoort niemand rond te kijken.
Options -Indexes

# verzenden.php is alleen bedoeld om ingeladen te worden, niet om zelf op te
# vragen. Los aanroepen levert een lege pagina op, maar we sluiten het af.
<Files "verzenden.php">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>
