# ============================================================================
#  DH Studio — serverinstellingen
#  Werkt op Apache en LiteSpeed (Hostinger). Regels die de server niet kent,
#  worden overgeslagen dankzij de <IfModule>-blokken.
# ============================================================================

# ----------------------------------------------------------------- 404
ErrorDocument 404 /404.html

# ----------------------------------------------------------------- adressen
# Eén adres voor de site: dhstudio.nl. Zonder dit hebben dhstudio.nl,
# www.dhstudio.nl en dh-studio.nl elk hun eigen versie: bezoekers landen op
# de verkeerde en Google verdeelt je posities over meerdere adressen.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# altijd https
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^(.*)$ https://dhstudio.nl/$1 [R=301,L]

	# alles wat niet exact dhstudio.nl is (www, of het adres met een
	# streepje) gaat door naar dhstudio.nl
	RewriteCond %{HTTP_HOST} !^dhstudio\.nl$ [NC]
	RewriteRule ^(.*)$ https://dhstudio.nl/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------- oude adressen
# Pagina's die op dh-studio.nl bestonden maar hier niet meer. De regel
# hierboven zet dh-studio.nl/werkwijze om naar dhstudio.nl/werkwijze, en dat
# adres bestaat niet: dan krijgt de bezoeker een 404 en laat Google de pagina
# uit de index vallen zonder de waarde door te geven. Een 301 naar de pagina
# die het onderwerp overnam, houdt die waarde wel vast.
#
# Staat er een oud adres in Search Console dat hier nog niet bij staat, zet
# het er dan onder in dezelfde vorm. NE zorgt dat het #-teken blijft staan
# en niet als %23 doorgegeven wordt.
<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteRule ^werkwijze/?$ /over-dh-studio#werkwijze [R=301,NE,L]
</IfModule>

# ----------------------------------------------------------------- tekens
# De charset staat al in een meta-tag, maar een browser leest de HTTP-header
# eerder. Zonder deze regel moet hij eerst gokken en daarna corrigeren.
AddDefaultCharset UTF-8

# ----------------------------------------------------------------- veiligheid
# Geen mappenlijst als er toevallig geen index-bestand staat. Zonder dit
# kan /assets/logos/ zijn hele inhoud tonen.
Options -Indexes

# Verbergt de precieze serverversie in foutpagina's.
ServerSignature Off

<IfModule mod_headers.c>
	# De browser mag het bestandstype niet zelf gaan raden. Voorkomt dat een
	# geupload bestand alsnog als script wordt uitgevoerd.
	Header always set X-Content-Type-Options "nosniff"

	# Bij het doorklikken naar een andere site gaat alleen het domein mee,
	# niet het volledige adres van de pagina waar iemand vandaan kwam.
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# Niemand mag de site in een frame op zijn eigen domein zetten
	# (clickjacking). frame-ancestors is de moderne vorm, X-Frame-Options
	# staat erbij voor oudere browsers.
	Header always set Content-Security-Policy "frame-ancestors 'self'"
	Header always set X-Frame-Options "SAMEORIGIN"

	# Camera, microfoon en locatie worden nergens gebruikt; zet ze uit.
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

	# Een venster dat wij openen komt niet in dezelfde browsercontext.
	Header always set Cross-Origin-Opener-Policy "same-origin"

	# Een jaar lang alleen nog via https. Bewust zonder includeSubDomains:
	# dat geldt dan ook voor subdomeinen die misschien geen certificaat
	# hebben. Draait alles op subdomeinen straks ook op https, dan kan
	# "; includeSubDomains" erachter.
	Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Een volledige Content-Security-Policy voor scripts staat hier bewust niet.
# De pagina's hebben hun opmaak en scripts inline staan, dus zo'n regel zou
# alleen met 'unsafe-inline' werken - en dan beschermt hij nergens tegen.
# Wil je dat echt, dan moeten eerst alle inline blokken naar losse bestanden.

# ----------------------------------------------------------------- inpakken
# Scheelt ongeveer 70% aan overdracht op HTML en CSS.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json
	AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ----------------------------------------------------------------- bewaren
# Een week is lang genoeg om laadtijd te winnen en kort genoeg om een
# vervangen afbeelding of logo binnen afzienbare tijd te zien. Lettertypes
# veranderen echt nooit, die mogen een jaar. HTML wordt nooit bewaard.
#
# Let op: gebruik hier geen "immutable". Dan negeert de browser elke
# controle en blijft een vervangen bestand maanden hangen.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpeg              "access plus 7 days"
	ExpiresByType image/png               "access plus 7 days"
	ExpiresByType image/webp              "access plus 7 days"
	ExpiresByType image/svg+xml           "access plus 7 days"
	ExpiresByType font/woff2              "access plus 1 year"
	ExpiresByType text/css                "access plus 7 days"
	ExpiresByType application/javascript  "access plus 7 days"
	ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
	<FilesMatch "\.(jpg|jpeg|png|webp|svg)$">
		Header set Cache-Control "public, max-age=604800, must-revalidate"
	</FilesMatch>
	<FilesMatch "\.(js|css)$">
		Header set Cache-Control "public, max-age=604800, must-revalidate"
	</FilesMatch>
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>

# ----------------------------------------------------------------- afschermen
# De map met gegevens en de code van het beheerpaneel horen niet in een browser.
<FilesMatch "^\.">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
