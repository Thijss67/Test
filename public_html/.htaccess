# ============================================================================
#  DH Studio — serverinstellingen
#  Werkt op Apache en LiteSpeed (Hostinger). Regels die de server niet kent,
#  worden overgeslagen dankzij de <IfModule>-blokken.
# ============================================================================

# ----------------------------------------------------------------- 404
ErrorDocument 404 /404.html

# ----------------------------------------------------------------- adressen
# Eén adres voor de site: dhstudio.nl. Zonder dit hebben dhstudio.nl,
# www.dhstudio.nl en dh-studio.nl elk hun eigen versie: bezoekers landen op
# de verkeerde en Google verdeelt je posities over meerdere adressen.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# altijd https
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^(.*)$ https://dhstudio.nl/$1 [R=301,L]

	# alles wat niet exact dhstudio.nl is (www, of het adres met een
	# streepje) gaat door naar dhstudio.nl
	RewriteCond %{HTTP_HOST} !^dhstudio\.nl$ [NC]
	RewriteRule ^(.*)$ https://dhstudio.nl/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------- inpakken
# Scheelt ongeveer 70% aan overdracht op HTML en CSS.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json
	AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# ----------------------------------------------------------------- bewaren
# Afbeeldingen en lettertypes veranderen zelden; die mag de browser een jaar
# bewaren. HTML niet: anders zien bezoekers je aanpassingen niet.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/jpeg              "access plus 1 year"
	ExpiresByType image/png               "access plus 1 year"
	ExpiresByType image/webp              "access plus 1 year"
	ExpiresByType image/svg+xml           "access plus 1 year"
	ExpiresByType font/woff2              "access plus 1 year"
	ExpiresByType text/css                "access plus 1 month"
	ExpiresByType application/javascript  "access plus 1 month"
	ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
	<FilesMatch "\.(jpg|jpeg|png|webp|svg|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>

# ----------------------------------------------------------------- afschermen
# De map met gegevens en de code van het beheerpaneel horen niet in een browser.
<FilesMatch "^\.">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# ----------------------------------------------------------------- headers
# Deze regels vertellen de browser wat hij w&eacute;l en niet mag doen op deze
# site. Ze kosten niets en vangen een hoop standaardaanvallen af.
<IfModule mod_headers.c>
	# Browser mag een jaar lang alleen nog via https verbinden.
	# Let op: pas aanzetten als https op alle subdomeinen werkt.
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Geen gokwerk over bestandstypes: voorkomt dat een geupload plaatje
	# alsnog als script wordt uitgevoerd.
	Header always set X-Content-Type-Options "nosniff"

	# De site mag niet in een frame van iemand anders staan (clickjacking).
	Header always set X-Frame-Options "DENY"

	# Bij het doorklikken naar een andere site geven we alleen het domein mee,
	# niet de volledige pagina waar iemand vandaan kwam.
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# Wij hebben camera, microfoon en locatie niet nodig; dus uit.
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

	# Welke bronnen de pagina mag laden. Alles wat er niet in staat, wordt
	# geblokkeerd. De inline stijl en scripts van de site zijn toegestaan;
	# extern mag alleen Google (lettertypes en, na toestemming, Ads).
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://googleads.g.doubleclick.net; frame-src https://td.doubleclick.net https://www.googletagmanager.com; upgrade-insecure-requests"

	# De servernaam en PHP-versie hoeven bezoekers niet te weten.
	Header unset X-Powered-By
	Header always unset X-Powered-By
</IfModule>

# ----------------------------------------------------------------- afschermen
# Geen mappenoverzicht als er geen index-bestand staat.
Options -Indexes

# Bestanden die nooit in een browser horen, ook niet per ongeluk.
<FilesMatch "(^\.|\.(md|json|log|bak|old|orig|sql|ini|sh|yml|yaml|lock|dist|tmp)$|^(composer|package|LEES-MIJ|README))">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Extensieloze kopie&euml;n van configuratiebestanden (zoals een per ongeluk
# gedownloade .htaccess) mogen ook niet opgehaald worden.
<Files "download">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>

# PHP verstopt zichzelf niet in de uploadmap.
<IfModule mod_php.c>
	php_flag display_errors Off
</IfModule>
